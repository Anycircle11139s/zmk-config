if SHIELD_SPLIT_KB_LEFT

config ZMK_KEYBOARD_NAME
    default "Split KB"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_SPLIT_KB_LEFT || SHIELD_SPLIT_KB_RIGHT

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

config ZMK_BATTERY_REPORTING
    default y

config ZMK_SLEEP
    default y

endif
