/*
 * Split KB - Left Half (Central)
 * Board: nice!nano v2 (nRF52840)
 *
 * ┌─────────────────────────────────────────────────────────────────────────┐
 * │  ⚠️  VERIFY THESE PIN ASSIGNMENTS AGAINST YOUR SCHEMATIC TRACES         │
 * │  The PDF text extraction cannot show wire routing.                       │
 * │  Compare the net labels (COL0-5, ROW0-4, Encoder_A/B) in KiCad to      │
 * │  the actual nice!nano pads on your PCB before flashing.                 │
 * └─────────────────────────────────────────────────────────────────────────┘
 *
 * Pin mapping (standard nice!nano v2 Lily58-style):
 *
 *   ROW0 → P0.31  (gpio0  31)  nice!nano pin 17
 *   ROW1 → P0.29  (gpio0  29)  nice!nano pin 18
 *   ROW2 → P0.02  (gpio0   2)  nice!nano pin 19
 *   ROW3 → P1.15  (gpio1  15)  nice!nano pin 20
 *   ROW4 → P1.13  (gpio1  13)  nice!nano pin 21
 *
 *   COL0 → P0.22  (gpio0  22)  nice!nano pin 7
 *   COL1 → P0.24  (gpio0  24)  nice!nano pin 8
 *   COL2 → P1.00  (gpio1   0)  nice!nano pin 9
 *   COL3 → P0.11  (gpio0  11)  nice!nano pin 10
 *   COL4 → P1.04  (gpio1   4)  nice!nano pin 11
 *   COL5 → P1.06  (gpio1   6)  nice!nano pin 12
 *
 *   Encoder A → P1.11  (gpio1  11)  nice!nano pin 22
 *   Encoder B → P0.09  (gpio0   9)  nice!nano pin 24
 *
 * Diode direction: col2row
 *   Columns are driven outputs; rows are pulled-down inputs.
 *   Signal path: COL → switch → diode (cathode→row side) → ROW
 *   If keys register wrong, swap to row2col and swap col/row gpio flags.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    /*
     * Full matrix transform covering BOTH halves.
     * Left  half  = columns  0–5  (physical COL 0–5 on left  nice!nano)
     * Right half  = columns 6–11 (physical COL 0–5 on right nice!nano)
     *
     * Row 4 thumb cluster: only 4 keys per side are populated.
     * RC(4,0) = left encoder click  (outermost left thumb position)
     * RC(4,10)= empty               (no switch soldered)
     * RC(4,11)= right encoder click (outermost right thumb position)
     * Adjust these RC() positions if your encoder click is elsewhere.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
/* ╔═══════╦═══════╦═══════╦═══════╦═══════╦═══════╗                   ╔═══════╦═══════╦═══════╦═══════╦═══════╦═══════╗ */
   RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)                RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11)
/* ╠═══════╬═══════╬═══════╬═══════╬═══════╬═══════╣                   ╠═══════╬═══════╬═══════╬═══════╬═══════╬═══════╣ */
   RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)                RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11)
/* ╠═══════╬═══════╬═══════╬═══════╬═══════╬═══════╣                   ╠═══════╬═══════╬═══════╬═══════╬═══════╬═══════╣ */
   RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)                RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11)
/* ╠═══════╬═══════╬═══════╬═══════╬═══════╬═══════╣                   ╠═══════╬═══════╬═══════╬═══════╬═══════╬═══════╣ */
   RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)                RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11)
/* ╚═══════╩═══════╩═╦═════╦═╦═════╦═╦═════╦═╦═════╦══╗           ╔══╦═╦═════╦═╦═════╦═╦═════╦═╦═════╦═╩═══════╩═══════╝ */
   RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)                RC(4,6)  RC(4,7)  RC(4,8)  RC(4,9)  RC(4,10) RC(4,11)
        >;
    };

    /* Left rotary encoder (SW57 in schematic) */
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* Encoder_A → P1.11 */
        b-gpios = <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* Encoder_B → P0.09 */
        resolution = <4>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        /* Columns → driven output (active high) */
        col-gpios
            = <&gpio0 22 GPIO_ACTIVE_HIGH>   /* COL0 → P0.22 */
            , <&gpio0 24 GPIO_ACTIVE_HIGH>   /* COL1 → P0.24 */
            , <&gpio1  0 GPIO_ACTIVE_HIGH>   /* COL2 → P1.00 */
            , <&gpio0 11 GPIO_ACTIVE_HIGH>   /* COL3 → P0.11 */
            , <&gpio1  4 GPIO_ACTIVE_HIGH>   /* COL4 → P1.04 */
            , <&gpio1  6 GPIO_ACTIVE_HIGH>   /* COL5 → P1.06 */
            ;

        /* Rows → sensed input (active high, pull-down) */
        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW0 → P0.31 */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW1 → P0.29 */
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW2 → P0.02 */
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW3 → P1.15 */
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW4 → P1.13 */
            ;
    };
};
