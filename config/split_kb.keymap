#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            bindings = <
/* L-R0 */ &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
/* L-R1 */ &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T
/* L-R2 */ &kp LSHFT  &kp A     &kp S     &kp D     &kp F     &kp G
/* L-R3 */ &kp LCTRL  &kp Z     &kp X     &kp C     &kp V     &kp B
/* L-R4 */ &kp C_MUTE &kp LGUI  &kp LALT  &kp DEL   &mo LOWER &kp SPACE
/* R-R0 */ &kp N6     &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
/* R-R1 */ &kp Y      &kp U     &kp I     &kp O     &kp P     &kp MINUS
/* R-R2 */ &kp H      &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
/* R-R3 */ &kp N      &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
/* R-R4 */ &kp RET    &mo RAISE &kp RALT  &kp RGUI  &none     &kp C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN
                                &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            label = "LOWER";
            bindings = <
/* L-R0 */ &kp GRAVE  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5
/* L-R1 */ &trans     &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT
/* L-R2 */ &trans     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
/* L-R3 */ &trans     &trans    &trans    &trans    &trans    &kp LPAR
/* L-R4 */ &trans     &trans    &trans    &trans    &trans    &trans
/* R-R0 */ &kp F6     &kp F7    &kp F8    &kp F9    &kp F10   &kp DEL
/* R-R1 */ &kp CARET  &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
/* R-R2 */ &kp N6     &kp N7    &kp N8    &kp N9    &kp N0    &trans
/* R-R3 */ &kp RPAR   &kp MINUS &kp PLUS  &kp LBKT  &kp RBKT  &kp BSLH
/* R-R4 */ &trans     &mo ADJUST &trans   &trans    &none     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN
                                &inc_dec_kp C_NEXT C_PREV>;
        };

        raise_layer {
            label = "RAISE";
            bindings = <
/* L-R0 */ &trans     &kp F11   &kp F12   &trans    &trans    &trans
/* L-R1 */ &trans     &trans    &trans    &trans    &trans    &trans
/* L-R2 */ &trans     &trans    &trans    &trans    &trans    &trans
/* L-R3 */ &trans     &trans    &trans    &trans    &trans    &kp LBRC
/* L-R4 */ &trans     &trans    &trans    &trans    &mo ADJUST &trans
/* R-R0 */ &trans     &trans    &trans    &trans    &trans    &kp DEL
/* R-R1 */ &trans     &trans    &kp UP    &trans    &trans    &trans
/* R-R2 */ &trans     &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans
/* R-R3 */ &kp RBRC   &kp UNDER &kp EQUAL &kp LBRC  &kp RBRC  &kp PIPE
/* R-R4 */ &trans     &trans    &trans    &trans    &none     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN
                                &inc_dec_kp C_NEXT C_PREV>;
        };

        adjust_layer {
            label = "ADJUST";
            bindings = <
/* L-R0 */ &bootloader &none    &none     &none     &none     &none
/* L-R1 */ &sys_reset  &none    &none     &none     &none     &none
/* L-R2 */ &none  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
/* L-R3 */ &none       &none    &none     &none     &none     &bt BT_CLR
/* L-R4 */ &none       &none    &none     &none     &none     &none
/* R-R0 */ &none       &none    &none     &none     &none     &bootloader
/* R-R1 */ &none       &none    &none     &none     &none     &sys_reset
/* R-R2 */ &none       &none    &none     &none     &none     &none
/* R-R3 */ &out OUT_TOG &none   &none     &none     &none     &none
/* R-R4 */ &none       &none    &none     &none     &none     &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN
                                &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
