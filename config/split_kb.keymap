/*
 * Split KB Keymap
 *
 * Layout: Lily58-style, 5×12 matrix (5 rows × 6 cols per half)
 *         60 total positions — each layer needs exactly 60 bindings.
 *
 * Binding ORDER matches the matrix transform in split_kb_left.overlay:
 *   First 30 = LEFT  half  (rows 0–4, cols 0–5,  row-major)
 *   Last  30 = RIGHT half  (rows 0–4, cols 6–11, row-major)
 *
 * Physical layout per row:
 *
 *   L-R0:  ESC   1     2     3     4     5          6     7     8     9     0    BSPC
 *   L-R1:  TAB   Q     W     E     R     T          Y     U     I     O     P     -
 *   L-R2: LSFT   A     S     D     F     G          H     J     K     L     ;     '
 *   L-R3: LCTL   Z     X     C     V     B          N     M     ,     .     /   RSFT
 *   L-R4: [ENC] LGUI LALT   DEL  LOWR  SPC        RET  RAIS RALT  RGUI  [---] [ENC]
 *
 *   [ENC] = encoder push-button (C_MUTE on left, C_PP on right)
 *   [---] = unconnected matrix position → &none
 *
 * Encoders:
 *   Left  (SW57): rotate = Vol Up / Vol Dn   (all layers except LOWER = Brightness)
 *   Right (SW58): rotate = Page Up / Page Dn (all layers except RAISE = Next/Prev track)
 *
 * Layers:
 *   0 = QWERTY (default)
 *   1 = LOWER  (numbers on home row, symbols)
 *   2 = RAISE  (F-keys, navigation arrows)
 *   3 = ADJUST (BLE management, bootloader, reset)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ── Layer 0: QWERTY ─────────────────────────────────────────────── */
        default_layer {
            label = "QWERTY";
            bindings = <
/* LEFT  R0 */ &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
/* LEFT  R1 */ &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T
/* LEFT  R2 */ &kp LSHFT  &kp A     &kp S     &kp D     &kp F     &kp G
/* LEFT  R3 */ &kp LCTRL  &kp Z     &kp X     &kp C     &kp V     &kp B
/* LEFT  R4 */ &kp C_MUTE &kp LGUI  &kp LALT  &kp DEL   &mo LOWER &kp SPACE
/* RIGHT R0 */ &kp N6     &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
/* RIGHT R1 */ &kp Y      &kp U     &kp I     &kp O     &kp P     &kp MINUS
/* RIGHT R2 */ &kp H      &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
/* RIGHT R3 */ &kp N      &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
/* RIGHT R4 */ &kp RET    &mo RAISE &kp RALT  &kp RGUI  &none     &kp C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN
                                &inc_dec_kp PG_UP PG_DN>;
        };

        /* ── Layer 1: LOWER ─────────────────────────────────────────────── */
        /*    F-keys on top row, number row on home row, symbols on row 3     */
        lower_layer {
            label = "LOWER";
            bindings = <
/* LEFT  R0 */ &kp GRAVE  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5
/* LEFT  R1 */ &trans     &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT
/* LEFT  R2 */ &trans     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
/* LEFT  R3 */ &trans     &trans    &trans    &trans    &trans    &kp LPAR
/* LEFT  R4 */ &trans     &trans    &trans    &trans    &trans    &trans
/* RIGHT R0 */ &kp F6     &kp F7    &kp F8    &kp F9    &kp F10   &kp DEL
/* RIGHT R1 */ &kp CARET  &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
/* RIGHT R2 */ &kp N6     &kp N7    &kp N8    &kp N9    &kp N0    &trans
/* RIGHT R3 */ &kp RPAR   &kp MINUS &kp PLUS  &kp LBKT  &kp RBKT  &kp BSLH
/* RIGHT R4 */ &trans     &mo ADJUST &trans   &trans    &none     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN
                                &inc_dec_kp C_NEXT C_PREV>;
        };

        /* ── Layer 2: RAISE ─────────────────────────────────────────────── */
        /*    Navigation, F11/F12, shifted symbols                            */
        raise_layer {
            label = "RAISE";
            bindings = <
/* LEFT  R0 */ &trans     &kp F11   &kp F12   &trans    &trans    &trans
/* LEFT  R1 */ &trans     &trans    &trans    &trans    &trans    &trans
/* LEFT  R2 */ &trans     &trans    &trans    &trans    &trans    &trans
/* LEFT  R3 */ &trans     &trans    &trans    &trans    &trans    &kp LBRC
/* LEFT  R4 */ &trans     &trans    &trans    &trans    &mo ADJUST &trans
/* RIGHT R0 */ &trans     &trans    &trans    &trans    &trans    &kp DEL
/* RIGHT R1 */ &trans     &trans    &kp UP    &trans    &trans    &trans
/* RIGHT R2 */ &trans     &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans
/* RIGHT R3 */ &kp RBRC   &kp UNDER &kp EQUAL &kp LBRC  &kp RBRC  &kp PIPE
/* RIGHT R4 */ &trans     &trans    &trans    &trans    &none     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN
                                &inc_dec_kp C_NEXT C_PREV>;
        };

        /* ── Layer 3: ADJUST ────────────────────────────────────────────── */
        /*    BLE profile switching, bootloader, reset                        */
        /*    Activated by holding LOWER + RAISE simultaneously               */
        adjust_layer {
            label = "ADJUST";
            bindings = <
/* LEFT  R0 */ &bootloader &none    &none     &none     &none     &none
/* LEFT  R1 */ &sys_reset  &none    &none     &none     &none     &none
/* LEFT  R2 */ &none       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
/* LEFT  R3 */ &none       &none    &none     &none     &none     &bt BT_CLR
/* LEFT  R4 */ &none       &none    &none     &none     &none     &none
/* RIGHT R0 */ &none       &none    &none     &none     &none     &bootloader
/* RIGHT R1 */ &none       &none    &none     &none     &none     &sys_reset
/* RIGHT R2 */ &none       &none    &none     &none     &none     &none
/* RIGHT R3 */ &out OUT_TOG &none   &none     &none     &none     &none
/* RIGHT R4 */ &none       &none    &none     &none     &none     &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN
                                &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
